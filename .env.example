# Public build-time switch. Only the literal false hides the launcher. Rebuild after changing.
VITE_ASSISTANT_ENABLED=true
# Server switch. Set false to stop API requests independently of the frontend.
ASSISTANT_ENABLED=true
# Server-only. Never prefix secrets with VITE_. Set in .env.local or hosting settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CHAT_DAILY_LIMIT=100
# Required in production (Vercel or any Node host). One shared Redis store across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# A random secret of at least 32 characters, used to HMAC IPs before storing rate counters.
CHAT_RATE_LIMIT_SECRET=
# Local Node server settings; Vercel does not need these.
PORT=5173
HOST=127.0.0.1
# For a self-hosted Node server only: use your known proxy topology; don't guess.
TRUST_PROXY_HOPS=0
